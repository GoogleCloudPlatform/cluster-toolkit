# Namespace and pod quota for the NVIDIA DRA driver.
# The NVIDIA DRA driver needs at least (2 * number of A5X nodes + 1) pods at
# system-node-critical / system-cluster-critical priority. That assumes one
# ComputeDomain per node. Each ComputeDomain adds one IMEX daemon pod per
# node, and a 4-GPU node can host more than one, so this allows up to 4 pods
# per node + 1. Never below 100. If the quota is hit, the ComputeDomain stays
# NotReady; check `kubectl describe resourcequota -n nvidia-dra-driver-gpu`.
apiVersion: v1
kind: Namespace
metadata:
  name: nvidia-dra-driver-gpu
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: nvidia-dra-driver-gpu-quota
  namespace: nvidia-dra-driver-gpu
spec:
  hard:
    pods: "${max(100, 4 * static_node_count * num_node_pools + 1)}"
  scopeSelector:
    matchExpressions:
    - operator: In
      scopeName: PriorityClass
      values:
      - system-node-critical
      - system-cluster-critical
