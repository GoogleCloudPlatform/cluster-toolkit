apiVersion: cloud.google.com/v1
kind: ComputeClass
metadata:
  name: ${class_name}
spec:
  nodePoolAutoCreation:
    enabled: true
%{ if description != "" ~}
  description: "${description}"
%{ endif ~}
  priorities:
    - machineFamily: ${machine_family}
%{ if spot ~}
      spot: true
%{ endif ~}
      minCores: ${min_cores}
      minMemoryGb: ${min_memory_gb}
%{ if zone != "" ~}
      location:
        zones:
          - "${zone}"
%{ endif ~}
  nodePoolConfig:
    imageType: ${lower(image_type)}
    gvnic:
      enabled: true
    imageStreaming:
      enabled: true
%{ if length(node_labels) > 0 ~}
    nodeLabels:
%{ for k, v in node_labels ~}
      ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
%{ if length(taints) > 0 ~}
    taints:
%{ for t in taints ~}
      - key: "${t.key}"
        value: "${t.value}"
        effect: "${t.effect}"
%{ endfor ~}
%{ endif ~}
  autoscalingPolicy:
    consolidationDelayMinutes: 1
    consolidationThreshold: 0
