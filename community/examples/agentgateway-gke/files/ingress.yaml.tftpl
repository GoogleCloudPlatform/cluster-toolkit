---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: agentgateway-internal
  namespace: ${namespace}
spec:
  gatewayClassName: gke-l7-rilb
  listeners:
  - name: http
    protocol: HTTP
    port: 80
    allowedRoutes:
      namespaces:
        from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: agentgateway-ingress
  namespace: ${namespace}
spec:
  parentRefs:
  - name: agentgateway-internal
    sectionName: http
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: agentgateway-proxy
      port: 8080
---
apiVersion: networking.gke.io/v1
kind: HealthCheckPolicy
metadata:
  name: agentgateway-proxy
  namespace: ${namespace}
spec:
  default:
    config:
      type: HTTP
      httpHealthCheck:
        portSpecification: USE_FIXED_PORT
        port: 15021
        requestPath: /healthz/ready
  targetRef:
    group: ""
    kind: Service
    name: agentgateway-proxy
---
apiVersion: networking.gke.io/v1
kind: GCPBackendPolicy
metadata:
  name: agentgateway-proxy
  namespace: ${namespace}
spec:
  default:
    timeoutSec: 300
    logging:
      enabled: true
      # GKE uses millionths: 1000000 logs every request.
      sampleRate: 1000000
  targetRef:
    group: ""
    kind: Service
    name: agentgateway-proxy
