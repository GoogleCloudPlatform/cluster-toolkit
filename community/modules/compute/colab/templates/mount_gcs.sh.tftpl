exec > /tmp/mount_gcs.log 2>&1
set -x

set -e

echo "Starting generic auto-mount for GCS bucket: ${mount_gcs_bucket}"

# Ensure gcsfuse is installed (use POSIX >/dev/null 2>&1 since pss.py invokes /bin/sh)
if ! command -v gcsfuse >/dev/null 2>&1; then
  echo "Installing gcsfuse..."
  CODENAME=""
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    CODENAME="$VERSION_CODENAME"
  fi
  if [ -z "$CODENAME" ] && command -v lsb_release >/dev/null 2>&1; then
    CODENAME=$(lsb_release -c -s)
  fi
  CODENAME=$${CODENAME:-bookworm}
  export GCSFUSE_REPO="gcsfuse-$CODENAME"
  sudo mkdir -p /usr/share/keyrings
  curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/cloud.google.gpg
  echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt $GCSFUSE_REPO main" | sudo tee /etc/apt/sources.list.d/gcsfuse.list
  sudo apt-get update
  sudo apt-get install -y gcsfuse
fi

# Mount the bucket idempotently
if mountpoint -q "${mount_path}"; then
  echo "${mount_path} is already mounted."
else
  sudo fusermount3 -uz "${mount_path}" 2>/dev/null || sudo fusermount -uz "${mount_path}" 2>/dev/null || sudo umount -l "${mount_path}" 2>/dev/null || true
  mkdir -p "${mount_path}"
  echo "Mounting ${mount_gcs_bucket} to ${mount_path}..."
  sudo gcsfuse --implicit-dirs -o allow_other --file-mode 777 --dir-mode 777 "${mount_gcs_bucket}" "${mount_path}"
  echo "Mount successful."
fi
