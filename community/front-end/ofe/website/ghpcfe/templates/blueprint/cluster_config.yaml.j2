blueprint_name: {{ cluster.cloud_id }}

terraform_backend_defaults:
  type: gcs
  configuration:
    bucket: {{ state_bucket }}
    prefix: {{ state_prefix }}

vars:
  project_id: {{ project_id }}
  deployment_name: {{ cluster.cloud_id }}
  region: {{ cluster.cloud_region }}
  zone: {{ cluster.cloud_zone }}
  enable_cleanup_compute: True
  enable_bigquery_load: {{ cluster.use_bigquery }}
  
  labels:
    created_by: {{ site_name }}

deployment_groups:
- group: primary
  modules:
  - source: modules/network/pre-existing-vpc
    kind: terraform
    settings:
      network_name: {{ cluster.subnet.vpc.cloud_id }}
      subnetwork_name: {{ cluster.subnet.cloud_id }}
    id: hpc_network

{% if artifact_registry_yaml %}
  - id: services-api
    source: community/modules/project/service-enablement
    settings:
      gcp_service_list:
        - secretmanager.googleapis.com
        - cloudbuild.googleapis.com
        - artifactregistry.googleapis.com
{% endif %}

{{ artifact_registry_yaml | safe }}

{{ filesystems_yaml | safe }}

{% if identity.profiles %}{% if not identity.own %}{% comment %}
Separate controller, login and compute accounts (clusterinfo.py
_identity_context). Each account module grants no project role; its
service-account-profiles block grants only what that role needs, and the node
module that uses the profile waits until the grants have propagated. Compute
accounts come first because the controller acts as them.

The Slurm files bucket is created here, not by the controller module, so that
each profile grants read access to it and its wait covers those grants: the
controller module's own grants are not ordered before its VMs, which could
boot before they took effect and abort setup. The profiles grant
legacyObjectReader and legacyBucketReader, not objectViewer: the bucket module
keeps an authoritative objectViewer binding, which would remove any other
objectViewer grant on the next apply. That binding lists the same accounts
the controller module grants objectViewer, so the two agree.

Nodes only read the TKFE control bucket (their bootstrap script and
clusters/ansible_setup). Their read grant carries an IAM condition limiting
it to listing the bucket and reading clusters/ansible_setup, the objects
under clusters/ansible_setup/ and this cluster's
clusters/<cluster id>/bootstrap_* files, so a node cannot read another
cluster's files or the server's. The exact name clusters/ansible_setup is
allowed as well as the prefix with its "/", because gcloud storage cp
--recursive may look that name up first, and the "/" keeps out any other
object whose name merely starts with clusters/ansible_setup. bootstrap_ has
no "/": it matches file names. Only the controller writes there:
its logs, under clusters/<cluster id>/. Its write grant carries an IAM
condition limiting it to that prefix, so it cannot change another cluster's
files or the server's own (webserver/startup.sh runs as root at every server
boot). IAM conditions need uniform bucket-level access, which the control
bucket has.
{% endcomment %}  - id: slurm_bucket
    source: modules/file-system/cloud-storage-bucket
    kind: terraform
    settings:
      name_prefix: slurm
      random_suffix: true
      force_destroy: true
      viewers:
      - serviceAccount:$({{ identity.controller }}_sa.service_account_email)
      - serviceAccount:$({{ identity.login }}_sa.service_account_email){% for name in identity.compute %}
      - serviceAccount:$({{ name }}_sa.service_account_email){% endfor %}

{% for name in identity.compute %}  - id: {{ name }}_sa
    source: modules/project/service-account
    kind: terraform
    settings:
      name: {{ name }}
      project_roles: []

  - id: {{ name }}_profile
    source: community/modules/iam/service-account-profiles
    kind: terraform
    use:
    - {{ name }}_sa
    settings:
      name: {{ name }}
      profile: slurm-compute{% if identity.role_id_suffix %}
      role_id_suffix: "{{ identity.role_id_suffix }}"{% endif %}
      bucket_bindings:
        ofe_bucket:
          bucket: "{{ identity.bucket }}"
          role: roles/storage.objectViewer
          condition:
            title: ofe-cluster-{{ cluster.id }}-node-files
            description: Lists the TKFE control bucket; reads only clusters/ansible_setup, the objects under it and clusters/{{ cluster.id }}/bootstrap_* in it.
            expression: resource.name == "projects/_/buckets/{{ identity.bucket }}" || resource.name == "projects/_/buckets/{{ identity.bucket }}/objects/clusters/ansible_setup" || resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/ansible_setup/") || resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/{{ cluster.id }}/bootstrap_")
        slurm_bucket_object_reader:
          bucket: $(slurm_bucket.gcs_bucket_name)
          role: roles/storage.legacyObjectReader
        slurm_bucket_reader:
          bucket: $(slurm_bucket.gcs_bucket_name)
          role: roles/storage.legacyBucketReader

{% endfor %}  - id: {{ identity.login }}_sa
    source: modules/project/service-account
    kind: terraform
    settings:
      name: {{ identity.login }}
      project_roles: []

  - id: {{ identity.login }}_profile
    source: community/modules/iam/service-account-profiles
    kind: terraform
    use:
    - {{ identity.login }}_sa
    settings:
      name: {{ identity.login }}
      profile: slurm-login{% if identity.role_id_suffix %}
      role_id_suffix: "{{ identity.role_id_suffix }}"{% endif %}
      bucket_bindings:
        ofe_bucket:
          bucket: "{{ identity.bucket }}"
          role: roles/storage.objectViewer
          condition:
            title: ofe-cluster-{{ cluster.id }}-node-files
            description: Lists the TKFE control bucket; reads only clusters/ansible_setup, the objects under it and clusters/{{ cluster.id }}/bootstrap_* in it.
            expression: resource.name == "projects/_/buckets/{{ identity.bucket }}" || resource.name == "projects/_/buckets/{{ identity.bucket }}/objects/clusters/ansible_setup" || resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/ansible_setup/") || resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/{{ cluster.id }}/bootstrap_")
        slurm_bucket_object_reader:
          bucket: $(slurm_bucket.gcs_bucket_name)
          role: roles/storage.legacyObjectReader
        slurm_bucket_reader:
          bucket: $(slurm_bucket.gcs_bucket_name)
          role: roles/storage.legacyBucketReader

  - id: {{ identity.controller }}_sa
    source: modules/project/service-account
    kind: terraform
    settings:
      name: {{ identity.controller }}
      project_roles: []

  - id: {{ identity.controller }}_profile
    source: community/modules/iam/service-account-profiles
    kind: terraform
    use:
    - {{ identity.controller }}_sa
    settings:
      name: {{ identity.controller }}
      profile: slurm-controller{% if identity.role_id_suffix %}
      role_id_suffix: "{{ identity.role_id_suffix }}"{% endif %}
      slurm_cluster_name: "{{ identity.slurm_cluster_name }}"
      enable_placement_policies: {{ identity.enable_placement_policies|yesno:"true,false" }}
      enable_bigquery_load: {{ identity.enable_bigquery_load|yesno:"true,false" }}{% if identity.compute %}
      act_as_service_accounts:{% for name in identity.compute %}
      - $({{ name }}_profile.service_account_email){% endfor %}{% endif %}
      bucket_bindings:
        ofe_bucket:
          bucket: "{{ identity.bucket }}"
          role: roles/storage.objectViewer
          condition:
            title: ofe-cluster-{{ cluster.id }}-node-files
            description: Lists the TKFE control bucket; reads only clusters/ansible_setup, the objects under it and clusters/{{ cluster.id }}/bootstrap_* in it.
            expression: resource.name == "projects/_/buckets/{{ identity.bucket }}" || resource.name == "projects/_/buckets/{{ identity.bucket }}/objects/clusters/ansible_setup" || resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/ansible_setup/") || resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/{{ cluster.id }}/bootstrap_")
        ofe_bucket_cluster_prefix:
          bucket: "{{ identity.bucket }}"
          role: roles/storage.objectUser
          condition:
            title: ofe-cluster-{{ cluster.id }}-prefix
            description: Objects under clusters/{{ cluster.id }}/ in the TKFE control bucket only.
            expression: resource.name.startsWith("projects/_/buckets/{{ identity.bucket }}/objects/clusters/{{ cluster.id }}/")
        slurm_bucket_object_reader:
          bucket: $(slurm_bucket.gcs_bucket_name)
          role: roles/storage.legacyObjectReader
        slurm_bucket_reader:
          bucket: $(slurm_bucket.gcs_bucket_name)
          role: roles/storage.legacyBucketReader
      pubsub_subscription_bindings:
        c2_subscription:
          project: "{{ identity.server_project }}"
          subscription: "{{ identity.c2_subscription }}"
          role: roles/pubsub.subscriber
      pubsub_topic_bindings:
        c2_topic:
          project: "{{ identity.server_project }}"
          topic: "{{ identity.c2_topic }}"
          role: roles/pubsub.publisher{% if identity.registries %}
      artifact_registry_bindings:{% for registry in identity.registries %}
        {{ registry }}:
          location: "{{ cluster.cloud_region }}"
          repository_id: $({{ registry }}.repository_id)
          role: roles/artifactregistry.reader{% endfor %}{% endif %}

{% endif %}{% else %}  - source: modules/project/service-account
    kind: terraform
    id: hpc_service_account
    settings:
      project_id: {{ project_id }}
      name: {{ controller_sa }}
      project_roles:
      - compute.instanceAdmin.v1
      - iam.serviceAccountUser
      - monitoring.metricWriter
      - logging.logWriter
      - storage.objectAdmin
      - pubsub.admin
      - compute.securityAdmin
      - iam.serviceAccountAdmin
      - resourcemanager.projectIamAdmin
      - compute.networkAdmin
      - artifactregistry.admin
      - secretmanager.secretAccessor
{% endif %}
{{ partitions_yaml | safe }}

{{ cloudsql_yaml | safe }}

  - source: community/modules/scheduler/schedmd-slurm-gcp-v6-controller
    kind: terraform
    id: slurm_controller
    settings:
      enable_slurm_auth: {{ cluster.enable_slurm_auth | lower }}
      instance_image:
        family: aci-cpu-rocky-linux-9-slurm-2605-amd64
        project: advanced-compute-images
      cloud_parameters:
        resume_rate: 0
        resume_timeout: 500
        suspend_rate: 0
        suspend_timeout: 300
        no_comma_params: false
      machine_type: {{ cluster.controller_instance_type }}
      disk_type: {{ cluster.controller_disk_type }}
      disk_size_gb: {{ cluster.controller_disk_size }}
      {{ controller_image_yaml | safe }}
{% if identity.profiles %}      slurm_cluster_name: "{{ identity.slurm_cluster_name }}"{% if identity.own %}
      service_account_email: "{{ identity.own.controller }}"{% else %}
      create_bucket: false
      bucket_name: $(slurm_bucket.gcs_bucket_name){% endif %}
      service_account_scopes:
        - https://www.googleapis.com/auth/cloud-platform
{% else %}      service_account_email: $(hpc_service_account.service_account_email)
      service_account_scopes:
        - https://www.googleapis.com/auth/cloud-platform
        - https://www.googleapis.com/auth/monitoring.write
        - https://www.googleapis.com/auth/logging.write
        - https://www.googleapis.com/auth/devstorage.read_write
        - https://www.googleapis.com/auth/pubsub
{% endif %}      compute_startup_scripts_timeout: 1200
      controller_startup_scripts_timeout: 1200
      controller_startup_script: |
        #!/bin/bash
        echo "******************************************** CALLING CONTROLLER STARTUP"
        gcloud storage cat gs://{{ startup_bucket }}/clusters/{{ cluster.id }}/bootstrap_controller.sh | bash
      login_startup_script: |
        #!/bin/bash
        echo "******************************************** CALLING LOGIN STARTUP"
        gcloud storage cat gs://{{ startup_bucket }}/clusters/{{ cluster.id }}/bootstrap_login.sh | bash
    use:
    - slurm_login
{{ controller_uses | safe }}

  - source: community/modules/scheduler/schedmd-slurm-gcp-v6-login
    kind: terraform
    id: slurm_login
    settings:
      instance_image:
        family: aci-cpu-rocky-linux-9-slurm-2605-amd64
        project: advanced-compute-images
      num_instances: {{ cluster.num_login_nodes }}
      subnetwork_self_link: "projects/{{ cluster.project_id }}/regions/{{ cluster.cloud_region }}/subnetworks/{{ cluster.subnet.cloud_id }}"
      machine_type: {{ cluster.login_node_instance_type }}
      disk_type: {{ cluster.login_node_disk_type }}
      disk_size_gb: {{ cluster.login_node_disk_size }}
      {{ login_image_yaml | safe }}
{% if identity.profiles %}{% if identity.own %}      service_account_email: "{{ identity.own.login }}"
{% endif %}      service_account_scopes:
        - https://www.googleapis.com/auth/cloud-platform{% if not identity.own %}
    use:
    - {{ identity.login }}_profile{% endif %}{% else %}      service_account_email: $(hpc_service_account.service_account_email)
      service_account_scopes:
        - https://www.googleapis.com/auth/cloud-platform
        - https://www.googleapis.com/auth/monitoring.write
        - https://www.googleapis.com/auth/logging.write
        - https://www.googleapis.com/auth/devstorage.read_write{% endif %}
