__pycache__/
*.py[cod]
.secret_key

# OFE generates its Django migrations at deploy time: the web server's
# startup.sh runs `makemigrations ghpcfe` followed by `migrate`, so the
# numbered migrations are build output rather than source and are not
# committed. Only __init__.py is tracked, so Django still sees a package.
ghpcfe/migrations/[0-9]*.py
