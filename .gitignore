community/front-end/ofe/CMEK_EXECPLAN.md
community/front-end/ofe/CMEK_GREENDOC.md
community/front-end/ofe/CMEK_IMPLEMENTATION_PLAN.md
community/front-end/ofe/CMEK_KEYGEN_CLUSTER_TOOLKIT_GREENDOC.md
community/front-end/ofe/CMEK_KEYGEN_EXECPLAN.md
community/front-end/ofe/CMEK_KEYGEN_GREENDOC.md
community/front-end/ofe/CMEK_KEYGEN_OFE_INTEGRATION_GREENDOC.md
community/front-end/ofe/CMEK_TEST_PLAN.md
community/front-end/ofe/Greendoc Examples.md

# Claude session artifacts
community/front-end/ofe/.claude/

# OFE generates its Django migrations at deploy time (webserver startup.sh runs
# makemigrations + migrate), so numbered migrations are not committed
community/front-end/ofe/website/ghpcfe/migrations/[0-9]*.py
