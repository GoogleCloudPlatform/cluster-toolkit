apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{.PVName}}
  labels:
    {{.ManagedByLabel}}: {{.ManagedByValue}}
    {{.StorageTypeLabel}}: {{.StorageType}}
spec:
  capacity:
    storage: {{.Capacity}}
  accessModes:
  - ReadWriteMany
  nfs:
    path: /{{.Share}}
    server: {{.IP}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{.PVCName}}
  labels:
    {{.ManagedByLabel}}: {{.ManagedByValue}}
    {{.StorageTypeLabel}}: {{.StorageType}}
spec:
  accessModes:
  - ReadWriteMany
  storageClassName: ""
  volumeName: {{.PVName}}
  resources:
    requests:
      storage: {{.Capacity}}
