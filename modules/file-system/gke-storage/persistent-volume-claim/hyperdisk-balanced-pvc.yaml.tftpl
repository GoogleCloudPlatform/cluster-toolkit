---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${pvc_name}
  namespace: ${namespace}
  labels:
  %{~ for key, val in labels ~}
    ${jsonencode(key)}: ${jsonencode(val)}
  %{~ endfor ~}
spec:
  accessModes:
    - ${access_mode}
  resources:
    requests:
      storage: ${capacity}
  storageClassName: ${storage_class_name}
