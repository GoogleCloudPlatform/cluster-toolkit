---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${pv_name}
  labels:
  %{~ for key, val in labels ~}
    ${jsonencode(key)}: ${jsonencode(val)}
  %{~ endfor ~}
spec:
  storageClassName: "${storage_class_name != null ? storage_class_name : ""}"
  capacity:
    storage: ${capacity}
  accessModes:
  - ReadWriteMany
  %{~ if try(length(mount_options), 0) > 0 ~}
  mountOptions:
  %{~ for key in mount_options ~}
  - ${jsonencode(key)}
  %{~ endfor ~}
  %{~ endif ~}
  csi:
    driver: gcsfuse.csi.storage.gke.io
    volumeHandle: ${bucket_name}
