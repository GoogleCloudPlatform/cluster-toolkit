---
kind: PersistentVolumeClaim
apiVersion: v1
metadata:
  name: ${pvc_name}
  namespace: ${namespace}
  labels:
  %{~ for key, val in labels ~}
    ${jsonencode(key)}: ${jsonencode(val)}
  %{~ endfor ~}
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: ""
  volumeName: ${pv_name}
  resources:
    requests:
      storage: ${capacity}
