[Unit]
Description=Configure Multi-NIC Lustre rails (policy routing + LNet)
After=network-online.target google-guest-agent.service
Wants=network-online.target
# Ordered before ALL remote mount units. Before=remote-fs.target would NOT be
# sufficient: the Lustre .mount unit is also Before=remote-fs.target, leaving
# the two mutually unordered.
Wants=remote-fs-pre.target
Before=remote-fs-pre.target
# First boot on Slurm: the mount is performed by slurm-gcp's setup.py, which
# runs inside google-startup-scripts.service rather than from fstab.
Before=google-startup-scripts.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/google/multinic-lustre.env
ExecStart=/usr/local/sbin/multi-nic-lustre-setup.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
